{
  "name": "super-dog",
  "version": "1.0.0",
  "description": "Desktop pet: a white Shih Tzu that follows your cursor",
  "author": "Super Dog",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check rename-preload.js && node --check rename.js && node --check renderer.js && node --check sprites.js",
    "test": "node --test",
    "package": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.superdog.desktop",
    "productName": "Super Dog",
    "files": [
      "main.js",
      "config.js",
      "preload.js",
      "rename-preload.js",
      "rename.js",
      "index.html",
      "rename.html",
      "renderer.js",
      "sprites.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon-256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@44.5.1": true
  }
}
